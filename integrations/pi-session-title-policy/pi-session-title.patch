+// Pi's JSONL header is the authoritative creation field. Do not substitute
+// the first message time, file mtime, or today's date when it is unavailable.
+export function readSessionCreatedAt(path: string | undefined): string | undefined {
+  if (!path) return;
+  try {
+    const first = readFileSync(path, "utf8").split(/\r?\n/u, 1)[0];
+    const header = JSON.parse(first) as { type?: unknown; timestamp?: unknown };
+    if (header.type !== "session" || typeof header.timestamp !== "string") return;
+    const time = Date.parse(header.timestamp);
+    return Number.isFinite(time) && time > 0 ? header.timestamp : undefined;
+  } catch {
+    return;
+  }
+}
+
+export function mmddShanghai(createdAt: string): string | undefined {
+  const time = Date.parse(createdAt);
+  if (!Number.isFinite(time) || time <= 0) return;
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: "Asia/Shanghai",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(new Date(time));
+  const month = parts.find((part) => part.type === "month")?.value;
+  const day = parts.find((part) => part.type === "day")?.value;
+  return month && day ? month + day : undefined;
+}
+
+export function cleanPolicyTitle(value: string, language: TitleLanguage, createdAt: string, maxLength: number): string | undefined {
+  const title = cleanTitle(value, maxLength);
+  const date = mmddShanghai(createdAt);
+  if (!title || !date) return;
+  const parts = title.split("｜").map((part) => part.trim());
+  if (parts.length !== 3 || parts[0] !== date || !parts[2]) return;
+  const detected = TITLE_TYPES.zh.includes(parts[1] as never) ? "zh" : TITLE_TYPES.en.includes(parts[1] as never) ? "en" : undefined;
+  if (!detected || (language !== "auto" && detected !== language)) return;
+  if (detected === "zh" && Array.from(parts[2]).length > 16) return;
+  if (detected === "en" && parts[2].split(/\s+/u).length > 8) return;
+  return parts.join("｜");
+}
